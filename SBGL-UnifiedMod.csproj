<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>SBGL.UnifiedMod</AssemblyName>
        <RootNamespace>SBGL.UnifiedMod</RootNamespace>
        <Product>Super Battle Golf League Unified Mod</Product>
        <Version>0.1.22</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="GameAssembly" Publicize="true">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\GameAssembly.dll</HintPath>
        </Reference>
        <Reference Include="SharedAssembly">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\SharedAssembly.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        
        <Reference Include="UnityEngine.UI">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.UI.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.UIModule.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Unity.TextMeshPro.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
        </Reference>

        <Reference Include="UnityEngine.UnityWebRequestModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UnityWebRequestTextureModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="Unity.InputSystem">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Unity.InputSystem.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\BepInEx\core\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
        </Reference>
        <Reference Include="Mirror">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Mirror.dll</HintPath>
        </Reference>
        <Reference Include="Steam">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Steam.dll</HintPath>
        </Reference>
        <Reference Include="Facepunch.Steamworks.Win64">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Facepunch.Steamworks.Win64.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="FMODUnity">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\FMODUnity.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Unity.Localization">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\Unity.Localization.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UIElementsModule">
            <HintPath>$(SUPER_BATTLE_GOLF_PATH)\Super Battle Golf_Data\Managed\UnityEngine.UIElementsModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyToPlugins" AfterTargets="Build">
        <PropertyGroup>
            <!-- The game folder is what BepInEx actually loads, so a build takes effect on the next
                 launch. Gale overwrites that folder whenever it deploys a profile, so the mod is
                 also written into the Gale profile to survive a redeploy. -->
            <GamePluginDir>$(SUPER_BATTLE_GOLF_PATH)\BepInEx\plugins\KingCox22-SBGL_UnifiedMod</GamePluginDir>
            <GaleProfileDir>$(APPDATA)\com.kesomannen.gale\super-battle-golf\profiles\SBGLeague\BepInEx\plugins\KingCox22-SBGL_UnifiedMod</GaleProfileDir>
        </PropertyGroup>

        <ItemGroup>
            <PluginPayload Include="$(OutputPath)$(AssemblyName).dll" />
            <PluginPayload Include="$(MSBuildProjectDirectory)\manifest.json" />
        </ItemGroup>

        <Copy SourceFiles="@(PluginPayload)" DestinationFolder="$(GamePluginDir)" SkipUnchangedFiles="false"
              Condition="'$(SUPER_BATTLE_GOLF_PATH)' != ''" />
        <Warning Text="SUPER_BATTLE_GOLF_PATH is not set — skipped copying the plugin into the game folder."
                 Condition="'$(SUPER_BATTLE_GOLF_PATH)' == ''" />

        <Copy SourceFiles="@(PluginPayload)" DestinationFolder="$(GaleProfileDir)" SkipUnchangedFiles="false"
              Condition="Exists('$(APPDATA)\com.kesomannen.gale\super-battle-golf\profiles\SBGLeague')" />
    </Target>

    <Target Name="CopyToThunderstore" AfterTargets="Build">
        <PropertyGroup>
            <!-- Staging folder holding exactly the files that go into the Thunderstore package.
                 The zip is written alongside it rather than inside it, so it never packages itself. -->
            <ThunderstoreRoot>C:\SBGL-Team</ThunderstoreRoot>
            <ThunderstoreDir>$(ThunderstoreRoot)\KingCox22-SBGL_UnifiedMod</ThunderstoreDir>
            <ThunderstoreZip>$(ThunderstoreRoot)\KingCox22-SBGL_UnifiedMod_$(Version).zip</ThunderstoreZip>
        </PropertyGroup>

        <MakeDir Directories="$(ThunderstoreDir)" />

        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ThunderstoreDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\manifest.json" DestinationFolder="$(ThunderstoreDir)" SkipUnchangedFiles="false" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\CHANGELOG.md" DestinationFolder="$(ThunderstoreDir)" SkipUnchangedFiles="false" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\README.md" DestinationFolder="$(ThunderstoreDir)" SkipUnchangedFiles="false"
              Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />

        <!-- Thunderstore requires icon.png to be exactly 256x256. The icon.png in the project root
             is the high-resolution master, so the packaged copy comes from Thunderstore\icon.png. -->
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Thunderstore\icon.png" DestinationFolder="$(ThunderstoreDir)" SkipUnchangedFiles="false"
              Condition="Exists('$(MSBuildProjectDirectory)\Thunderstore\icon.png')" />

        <!-- Thunderstore rejects uploads missing either of these, so warn rather than fail the build. -->
        <Warning Text="README.md is missing — Thunderstore will reject the package until one is added."
                 Condition="!Exists('$(MSBuildProjectDirectory)\README.md')" />
        <Warning Text="Thunderstore\icon.png (256x256) is missing — Thunderstore will reject the package until one is added."
                 Condition="!Exists('$(MSBuildProjectDirectory)\Thunderstore\icon.png')" />

        <!-- Built-in MSBuild zip: no Python or other external tooling required. -->
        <Delete Files="$(ThunderstoreZip)" />
        <ZipDirectory SourceDirectory="$(ThunderstoreDir)" DestinationFile="$(ThunderstoreZip)" />

        <Message Importance="high" Text="Thunderstore package: $(ThunderstoreZip)" />
    </Target>

</Project>